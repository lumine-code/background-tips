{
  "name": "background-tips",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Displays tips about Lumine in the background when no editors are open.",
  "keywords": [
    "hints",
    "welcome",
    "startup",
    "idle",
    "onboarding"
  ],
  "repository": "https://github.com/lumine-code/background-tips",
  "bugs": {
    "url": "https://github.com/lumine-code/background-tips/issues"
  },
  "license": "MIT",
  "main": "./lib/background-tips",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "displayDuration": {
      "title": "Display Duration",
      "description": "How long each background tip is shown, in seconds.",
      "type": "integer",
      "minimum": 1,
      "default": 10
    },
    "ignoredPackages": {
      "title": "Ignored Packages",
      "description": "Package names whose background tips are not shown.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "consumedServices": {
    "background-tips.provider": {
      "versions": {
        "^1.0.0": "consumeBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#7a4b307293a7795831841b1ae9b0d3a1843f3760",
    "liquidjs": "^10.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
}
